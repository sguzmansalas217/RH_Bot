# Sitio principal: www.rhasitente.com (con su certificado HTTPS automático).
www.rhasitente.com {
	# Caddy obtiene y renueva solo el certificado HTTPS (Let's Encrypt)
	# y reenvía todo el tráfico (panel + API + /webhook) a la app interna.
	reverse_proxy app:3000
}

# El dominio sin www redirige al www (para que ambos funcionen).
rhasitente.com {
	redir https://www.rhasitente.com{uri}
}
