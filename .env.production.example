# ═══ .env para el DROPLET (producción) ═══
# Copia este archivo como .env en el servidor y cambia las contraseñas.

# ─── Base de datos (interna de Docker) ───
POSTGRES_USER=rh_admin
POSTGRES_PASSWORD=PON_UNA_PASSWORD_FUERTE_AQUI
POSTGRES_DB=rh_sistema
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL la define docker-compose.deploy.yml automáticamente (host 'db').

# ─── Servidor ───
NODE_ENV=production
PORT=3000
TZ=America/Mexico_City

# ─── Panel admin ───
JWT_SECRET=CAMBIA_ESTO_POR_UN_TEXTO_LARGO_Y_ALEATORIO
JWT_EXPIRES=8h

# ─── IA (Claude) — opcional pero recomendado ───
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
AI_MODEL=claude-sonnet-5

# ─── WhatsApp (Baileys) ───
WHATSAPP_CHANNEL=baileys
BAILEYS_AUTH_DIR=./.baileys_auth
# En el Droplet NO hay proxy corporativo, así que déjalo en false:
WHATSAPP_INSECURE_TLS=false
# Tu número de administrador (E.164 sin +), para aprobar por WhatsApp:
ADMIN_WHATSAPP=52XXXXXXXXXX
