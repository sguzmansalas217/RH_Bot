# ─── Base de datos ───────────────────────────────────────────
POSTGRES_USER=rh_admin
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=rh_sistema
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rh_admin:cambia_esta_password@db:5432/rh_sistema

# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
TZ=America/Mexico_City
# Zona horaria oficial usada para toda la lógica de asistencia

# ─── Autenticación panel admin ───────────────────────────────
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRES=8h

# ─── IA (Claude) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
AI_MODEL=claude-sonnet-5

# ─── WhatsApp ────────────────────────────────────────────────
# Canal activo: baileys | cloud
WHATSAPP_CHANNEL=baileys
# Carpeta donde Baileys guarda la sesión (para no re-escanear QR)
BAILEYS_AUTH_DIR=./.baileys_auth
# Ponlo en true SOLO si estás en una red corporativa con inspección SSL y ves el
# error "unable to get local issuer certificate". Omite validar el certificado.
WHATSAPP_INSECURE_TLS=false
# Número(s) de administrador que pueden aprobar por WhatsApp (E.164, coma-separado)
ADMIN_WHATSAPP=5215555555555

# ─── (Futuro) WhatsApp Cloud API ─────────────────────────────
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_VERIFY_TOKEN=

# ─── Dominio / Nginx / Certbot ───────────────────────────────
DOMAIN=rh.tudominio.com
CERTBOT_EMAIL=admin@tudominio.com
